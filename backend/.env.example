# Environment variables for SevaConnect backend
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git

# MongoDB Atlas connection string
# Example: mongodb+srv://username:password@cluster.mongodb.net/sevaconnect
MONGO_URI=mongodb://localhost:27017/sevaconnect

# Django secret key - change this in production
DJANGO_SECRET_KEY=your-very-secret-django-key-change-this

# Set to False in production
DEBUG=True

# Google Gemini AI API key
# Get yours free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Razorpay payment keys (use test keys during development)
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Allowed origins for CORS (your React frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
