# Set this to the deployed backend URL when frontend and backend use separate domains.
# Include /api at the end. Leave unset for same-origin deployments.
VITE_API_URL=
# Example: VITE_API_URL=https://api.example.com/api

# Public browser key for Google Maps JavaScript API and Directions API.
# Restrict this key by allowed website referrers and enabled APIs in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=